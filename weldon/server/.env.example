# Copier ce fichier en .env puis remplir les valeurs.

# Adresse publique de l'application (sert d'URL de retour après paiement)
PUBLIC_URL=https://weldon.example.com
PORT=8080

# Secret pour signer les jetons d'accès : 32 caractères aléatoires minimum
# (générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
TOKEN_SECRET=

# Chariow : clé API (app.chariow.com/settings/api) et produit « Weldon – Accès 1 an »
CHARIOW_API_KEY=sk_live_xxx
CHARIOW_PRODUCT_ID=prd_xxx
# Secret de signature du Pulse (Automatisations → Pulses → Signing secret), commence par whsec_
CHARIOW_PULSE_SECRET=whsec_xxx

# Concepteur(s) : accès complet sans payer, et espace concepteur (séparés par des virgules)
ADMIN_EMAILS=

# Base PostgreSQL (ex. Neon, gratuit). Vide = fichier local (développement seulement)
DATABASE_URL=

PRICE_XAF=100000
ACCESS_DAYS=365


# Formule mensuelle (facultatif) : produit Chariow « Weldon – 1 mois ». Sans lui, seule la formule annuelle est proposée.
CHARIOW_PRODUCT_ID_MONTHLY=
PRICE_XAF_MONTHLY=15000
ACCESS_DAYS_MONTHLY=30
# Contact (facultatif) : chaîne d'alertes WhatsApp (lien https) et numéro WhatsApp du concepteur (chiffres, avec l'indicatif 237)
WHATSAPP_CHANNEL_URL=
WHATSAPP_NUMBER=

# Veille automatique : mot de passe long, identique au secret VEILLE_TOKEN de GitHub (voir README)
VEILLE_TOKEN=
