rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidHouseholdId(hid) {
      return hid is string && hid.size() == 10 && hid.matches('^[A-Z2-9]{10}$');
    }

    function isHouseholdMember(hid) {
      return isSignedIn() && (
        request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Household document
    match /households/{hid} {
      allow read: if isSignedIn() && isValidHouseholdId(hid);
      allow create: if isSignedIn() && isValidHouseholdId(hid)
        && request.resource.data.joinCode == hid
        && request.resource.data.members.hasOnly([request.auth.uid]);
      allow update: if isSignedIn() && isValidHouseholdId(hid) && (
        // Allow partner to join by adding only their own uid
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.size() <= 2
          && request.auth.uid in request.resource.data.members)
        ||
        // Allow members to update settings
        (request.auth.uid in resource.data.members)
      );
      allow delete: if isSignedIn() && isValidHouseholdId(hid) && request.auth.uid in resource.data.members;

      // Shared Goals
      match /goals/{goalId} {
        allow read, write: if isSignedIn() && isValidHouseholdId(hid);
      }

      // Shared Approvals
      match /approvals/{approvalId} {
        allow read, write: if isSignedIn() && isValidHouseholdId(hid);
      }

      // Member profiles
      match /members/{uid} {
        allow read: if isSignedIn() && isValidHouseholdId(hid);
        allow create, update: if isOwner(uid) && isValidHouseholdId(hid);
        allow delete: if isOwner(uid);

        // Member monthly budget plans & entries
        match /months/{monthId} {
          allow read: if isSignedIn() && isValidHouseholdId(hid);
          allow create, update: if isOwner(uid) && isValidHouseholdId(hid);
          allow delete: if isOwner(uid);
        }

        // Member private subcollections (wallets, debts, commitments, provisions, tontines)
        match /wallets/{docId} {
          allow read: if isSignedIn() && isValidHouseholdId(hid);
          allow write: if isOwner(uid);
        }

        match /debts/{docId} {
          allow read: if isSignedIn() && isValidHouseholdId(hid) && (
            isOwner(uid) || resource.data.shared == true
          );
          allow write: if isOwner(uid);
        }

        match /commitments/{docId} {
          allow read: if isSignedIn() && isValidHouseholdId(hid);
          allow write: if isOwner(uid);
        }

        match /provisions/{docId} {
          allow read: if isSignedIn() && isValidHouseholdId(hid);
          allow write: if isOwner(uid);
        }

        match /tontines/{docId} {
          allow read: if isSignedIn() && isValidHouseholdId(hid) && (
            isOwner(uid) || resource.data.shared == true
          );
          allow write: if isOwner(uid);
        }

        match /recipientMemory/{docId} {
          allow read, write: if isOwner(uid);
        }

        match /alerts/{docId} {
          allow read, write: if isOwner(uid);
        }
      }
    }
  }
}
